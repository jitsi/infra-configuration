[agent]
  interval = "60s"
  round_interval = false
  metric_batch_size = 1000
  metric_buffer_limit = 10000
  collection_jitter = "0s"
  flush_interval = "60s"
  flush_jitter = "0s"
  precision = ""
  debug = true
  quiet = false
  hostname = "{{ telegraf_hostname }}"
  omit_hostname = false
  logfile = "/var/log/telegraf/telegraf.log"

[[inputs.cpu]]
  percpu = false
  totalcpu = true
  collect_cpu_time = false
  report_active = false
  fielddrop = ["time_*"]
  fieldpass = ["usage_system*", "usage_user*", "usage_iowait*", "usage_idle*", "usage_steal*"]

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "overlay", "aufs", "squashfs", "nfs", "nfs4"]
  fieldpass = ["used_percent", "free", "used", "total"]

[[inputs.mem]]
  fieldpass = [ "active", "available", "buffered", "cached", "free", "total",  "used" ]

[[inputs.net]]
  fieldpass = ["bytes*","drop*","packets*","err*","tcp*","udp*"]

[[inputs.processes]]
  fieldpass = ["blocked", "idle", "paging", "running", "total*"]

[[inputs.swap]]
  fieldpass = ["total", "used"]

[[inputs.system]]
  fieldpass = ["load*"]

[[inputs.statsd]]
  service_address = ":{{ statsd_port }}"
  delete_gauges = true
  delete_counters = true
  delete_sets = true
  delete_timings = true
  percentiles = [90]
  metric_separator = "_"
  allowed_pending_messages = 10000
  percentile_limit = 1000
  datadog_extensions = {{ datadog_extensions }}

[[inputs.linux_sysctl_fs]]

# Telegraf's own health: per-input gather errors and gather time, output write
# errors, write buffer depth, and metrics dropped when that buffer overflows.
# Without it there is no way to tell a host that is genuinely quiet from one
# whose telegraf stopped keeping up, and statsd drops (which cost us jvb
# metrics) are invisible. Costs ~63 series per host.
#
# The nomad telegraf job (infra-provisioning nomad/telegraf.hcl) collects the
# same plugin under the same name_prefix, so one telegraf_internal_* query
# covers both populations. Two caveats when writing queries against it:
#
#   - the VM fleet runs telegraf 1.22.4 (wavefront_telegraf_deb_file) while the
#     nomad job runs 1.29.5, and 1.22.4 emits no *_gather_timeouts field. Alert
#     on gather_errors, which both versions have.
#   - do NOT add collect_gostats here until every VM population is on telegraf
#     >= 1.25. 1.22.4 has no such field and refuses to start on an unrecognized
#     config key ("configuration specified the fields [...], but they weren't
#     used"), which would take telegraf down fleet-wide.
[[inputs.internal]]
  name_prefix = "telegraf_"
  # go runtime stats are a large series block that we never act on
  collect_memstats = false

{% if telegraf_inputs is defined %}
{% for input_item in telegraf_inputs.keys() %}
{% if telegraf_inputs[input_item] is mapping %}
[[inputs.{{ input_item }}]]
{% for key, value in telegraf_inputs[input_item].items() %}
  {{ key }} = {{ value | to_json }}
{% endfor %}

{% else %}
{% for item in telegraf_inputs[input_item] %}
[[inputs.{{ input_item }}]]
{% for key, value in item.items() %}
  {{ key }} = {{ value | to_json }}
{% endfor %}

{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if telegraf_tags is defined %}
[global_tags]
{% for key, value in telegraf_tags.items() %}
  {{ key }} = "{{ value }}"
{% endfor %}
{% else %}
#[global_tags]
{% endif %}
